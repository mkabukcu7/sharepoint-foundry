AI_PROVIDER=mock

FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=<metadata-agent-name>
FOUNDRY_AGENT_VERSION=<version>
FOUNDRY_CLASSIFIER_AGENT_NAME=<classifier-agent-name>
FOUNDRY_CLASSIFIER_AGENT_VERSION=<version>
FOUNDRY_LIBRARIAN_AGENT_NAME=knowledge-librarian-agent
FOUNDRY_LIBRARIAN_AGENT_VERSION=2
FOUNDRY_LIBRARIAN_MODEL=gpt-5-mini
FOUNDRY_LIBRARIAN_PROMPT_PATH=prompts/knowledge-librarian-agent.md
FOUNDRY_TAXONOMY_PATH=taxonomy/controlled-terms.json
FOUNDRY_EXTRACTION_MODEL=gpt-5-mini
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_ENDPOINT=https://wtw-knowledge-search-2684.search.windows.net
SEARCH_INDEX_NAME=wtw-approved-knowledge
SEARCH_VECTOR_DIMENSIONS=1536
# Semantic ranker supplies the 0-4 rerankerScore used to decide whether the
# librarian has real evidence. Without it the librarian cannot abstain reliably,
# because hybrid RRF scores barely differ between relevant and irrelevant chunks.
# Enabled by default; turning it off makes retrieval refuse to judge relevance.
SEARCH_USE_SEMANTIC_RANKER=true
SEARCH_MIN_RERANKER_SCORE=1.9

SHAREPOINT_HOSTNAME=<tenant>.sharepoint.com
SHAREPOINT_SITE_PATH=/
SHAREPOINT_LIBRARY_NAME=Documents
SHAREPOINT_FOLDER_PATH=
SHAREPOINT_CREDENTIAL_MODE=default
SHAREPOINT_WRITEBACK_ENABLED=false
SHAREPOINT_STAGING_FOLDER_NAME=Staging
SHAREPOINT_REVIEWED_FOLDER_NAME=Reviewed
SHAREPOINT_ARCHIVE_FOLDER_NAME=Archive

# Knowledge Librarian intake triage
LIBRARIAN_CONFIDENCE_THRESHOLD=0.7
LIBRARIAN_REVIEW_SLA_DAYS=5
# Map application fields to SharePoint internal column names. Alongside the five
# free-text fields you may map the controlled-taxonomy fields materialType,
# topics, businesses, industries, geographies, collections and languages.
# Multi-value taxonomy selections are written to text columns joined with "; ".
SHAREPOINT_COLUMN_MAP={"businessArea":"BusinessArea","audience":"MetadataAudience","language":"MetadataLanguage","author":"MetadataAuthor","countryOfOrigin":"CountryofOrigin"}
