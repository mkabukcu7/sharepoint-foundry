# =====================================================================
# Local development configuration. Copy to `.env` and fill in values.
# In deployed environments these come from Key Vault via managed identity
# and are injected by `azd`. NEVER commit a real .env file.
# =====================================================================

# --- Microsoft Foundry (Azure AI Foundry) project ---
# Model deployment names (created by infra/). Defaults below match the
# broadly-available, verified set in infra/main.parameters.json. The
# architecture targets the gpt-4.1 family where quota is available.
# Project endpoint, e.g. https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
AGENT_MODEL_DEPLOYMENT=gpt-4o
TRIAGE_MODEL_DEPLOYMENT=gpt-4o
VISION_MODEL_DEPLOYMENT=gpt-4o
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-large

# --- Azure AI Search ---
SEARCH_ENDPOINT=
SEARCH_INDEX_NAME=workplace-knowledge
# Foundry connection id for the AI Search index tool (Agent Service)
SEARCH_CONNECTION_ID=

# --- Azure AI Content Safety ---
CONTENT_SAFETY_ENDPOINT=

# --- Document Intelligence ---
DOC_INTELLIGENCE_ENDPOINT=

# --- Azure AI Speech (batch transcription) ---
SPEECH_ENDPOINT=
SPEECH_REGION=

# --- Storage (ingestion staging) ---
STORAGE_ACCOUNT_URL=
STORAGE_CONTAINER=ingestion

# --- SharePoint grounding ---
SHAREPOINT_SITE_URL=https://<YourEnterprise>.sharepoint.com/sites/<page>
# Foundry connection id for the managed SharePoint tool (OBO identity passthrough)
SHAREPOINT_CONNECTION_ID=

# --- SharePoint (Indexed) Knowledge Source — Azure AI Search agentic retrieval ---
# Ingests SharePoint content into an Azure AI Search pipeline (data source +
# skillset + indexer + index). See docs/CONFIGURATION.md and
# https://learn.microsoft.com/azure/search/agentic-knowledge-source-how-to-sharepoint-indexed
# Azure OpenAI / Foundry resource URI used for the embedding (and optional
# image-verbalization) model. Defaults to FOUNDRY_PROJECT_ENDPOINT if unset.
AZURE_OPENAI_ENDPOINT=
# SharePoint indexer connection string (store the secret form in Key Vault).
SHAREPOINT_CONNECTION_STRING=
SHAREPOINT_KS_NAME=sharepoint-indexed-ks
# defaultSiteLibrary (default library) or allSiteLibraries
SHAREPOINT_CONTAINER_NAME=defaultSiteLibrary
# Include-only folder/library scoping (SharePoint indexer query syntax). Empty = whole container.
SHAREPOINT_KS_QUERY=
# Comma-separated ACL ingestion options for query-time permission enforcement, e.g. userIds,groupIds
SHAREPOINT_INGESTION_PERMISSIONS=
# Knowledge base that references the knowledge source(s)
KNOWLEDGE_BASE_NAME=workplace-knowledge-base

# --- Tableau structured-data lane ---
TABLEAU_SERVER_URL=
TABLEAU_SITE_ID=
TABLEAU_API_VERSION=3.21
# Personal Access Token (store in Key Vault in deployed environments)
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
# Datasource + field mapping for the metric query (VizQL Data Service)
TABLEAU_DATASOURCE_LUID=
TABLEAU_MEASURE_FIELD=
TABLEAU_DATE_FIELD=
TABLEAU_SOURCE_WORKBOOK=

# --- Behavior / thresholds (see docs/02-architecture.md §9, §15) ---
GROUNDEDNESS_MIN=4.2
RELEVANCE_MIN=4.0
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
LOW_CONFIDENCE_MIN_SCORE=0.30
MAX_EVIDENCE_TOKENS=6000

# --- Local dev only: prefer DefaultAzureCredential (az login / managed identity) ---
# Do not place secrets here in real deployments.
